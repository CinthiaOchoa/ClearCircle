# Server-only. Never use NEXT_PUBLIC_ prefixes for these values.
CLEARCIRCLE_API_URL=http://127.0.0.1:8787
# Must match the agent's API_TOKEN (32+ random characters).
CLEARCIRCLE_API_TOKEN=
# Separate strong shared password (at least 12 characters) for one-family prototype.
DASHBOARD_PASSWORD=

# Set the exact public origin (no trailing slash) when behind a reverse proxy.
# Local development can leave this empty and validate against Host.
DASHBOARD_ORIGIN=
