# Photon project from https://app.photon.codes
PROJECT_ID=
PROJECT_SECRET=
# Gemini key; use a model enabled for your account
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# E.164 phone number addresses. Both participants opt in by texting START/JOIN.
PARENT_ADDRESS=+15550001111
HELPER_ADDRESS=+15550002222
# A real existing group ID for dedicated Photon iMessage line; leave blank for degraded DM fallback.
FAMILY_GROUP_ID=
# SQLite is persisted locally; do not commit the database.
DATABASE_PATH=./clearcircle.sqlite
# Demo-only reminder; 60 seconds after the claim. For real deadlines set 0.
DEMO_REMINDER_SECONDS=60
# Web preview uses only fictional client-side data, not this private database.
